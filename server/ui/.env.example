# MiraBase dashboard build environment.
# PB_ variable names are retained for compatibility with the inherited build
# tooling. Help links are in-product MiraBase routes; MiraBase does not link
# to upstream documentation websites.
PB_BACKEND_URL = "../"
PB_VERSION = ""
PB_MFA_DOCS = "#/collections"
PB_OAUTH2_DOCS = "#/collections"
PB_RULES_SYNTAX_DOCS = "#/collections"
PB_FILE_UPLOAD_DOCS = "#/collections"
PB_PROTECTED_FILE_DOCS = "#/collections"
PB_REALTIME_DOCS = "#/collections"
PB_FIELDS_DOCS = "#/collections"
PB_SUPERUSER_IPS_RESET_DOCS = "#/settings"
PB_DOCS_URL = "#/settings"
PB_JS_SDK_URL = "#/collections"
PB_DART_SDK_URL = "#/collections"
